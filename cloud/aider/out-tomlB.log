def _unescape_basic(s):                                                         
    """Unescape basic string escapes, rejecting invalid ones."""                
    def repl(m):                                                                
        esc = m.group(1)                                                        
        if esc == 'b':                                                          
            return '\b'                                                         
        if esc == 't':                                                          
            return '\t'                                                         
        if esc == 'n':                                                          
            return '\n'                                                         
        if esc == 'f':                                                          
            return '\f'                                                         
        if esc == 'r':                                                          
            return '\r'                                                         
        if esc == '"':                                                          
            return '"'                                                          
        if esc == '\\':                                                         
            return '\\'                                                         
        if esc.startswith('u'):                                                 
            return chr(int(esc[1:], 16))                                        
        if esc.startswith('U'):                                                 
            return chr(int(esc[1:], 16))                                        
        _error(f"invalid escape \\{esc}")                                       
    # Replace valid escapes                                                     

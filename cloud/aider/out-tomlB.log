def _parse_inline_table(tok):                                                   
    """Parse an inline table { a = 1, b = \"x\" }."""                           
    content = tok.strip()                                                       
    if not (content.startswith('{') and content.endswith('}')):                 
        _error("invalid inline table")                                          
    inner = content[1:-1].strip()                                               
    if not inner:                                                               
        return _InlineTable()                                                   
    table = _InlineTable()                                                      
    # split on commas not inside strings                                        
    parts = []                                                                  
    token = ''                                                                  
    in_str = False                                                              
    delim = ''                                                                  
    for ch in inner:                                                            
        if in_str:                                                              
            token += ch                                                         
            if ch == delim and token[-2] != '\\':                               
                in_str = False                                                  
            continue                                                            
        if ch in ('"', "'"):                                                    
            in_str = True                                                       
            delim = ch                                                          
            token += ch                                                         
            continue                                                            
        if ch == ',':                                                           
            parts.append(token.strip())                                         
            token = ''                                                          
            continue                                                            
        token += ch                                                             
    if token.strip():                                                           
        parts.append(token.strip())                                             
    for part in parts:                                                          
        if '=' not in part:                                                     
            _error("invalid inline table entry")                                
        k, v = part.split('=', 1)                                               
        key = _parse_key(k.strip())                                             
        value = _parse_value(v.strip())                                         
        if key in table:                                                        
            _error(f"duplicate key {key} in inline table")                      
        table[key] = value                                                      
    return table                                                                

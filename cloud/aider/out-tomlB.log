    for raw in _line_iter:                                                      
        line = _strip_comments(raw).strip()                                     
        if not line:                                                            
            continue                                                            
        for ch in line:                                                         
            if ch == '[':                                                       
                depth += 1                                                      
            elif ch == ']':                                                     
                depth -= 1                                                      
                if depth == 0:                                                  
                    # end of array                                              
                    before = line[:line.rfind(']')]                             
                    inner += ' ' + before                                       
                    return _parse_array_items(inner)                            
        inner += ' ' + line                                                     
    _error("unterminated array")                                                

def parse_toml(lines):                                                          
    """Parse a sequence of lines (list of str) into an OrderedDict."""          
    data = OrderedDict()                                                        
    current_path = []          # list of strings                                
    array_table_stack = []     # for [[...]] handling                           
    lines_iter = iter(lines)                                                    
    for raw_line in lines_iter:                                                 

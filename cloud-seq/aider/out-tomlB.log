            continue                                                            
        # Table headers                                                         
        if line.startswith('[[') and line.endswith(']]'):                       
            inner = line[2:-2].strip()                                          
            parts = [p.strip() for p in _split_top_level(inner, '.')]           
            path = [_parse_key(p) for p in parts]                               
            # Navigate to parent array                                          
            tbl = data                                                          
            for seg in path[:-1]:                                               
                if seg not in tbl:                                              

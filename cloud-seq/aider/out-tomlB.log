Implement _unescape_basic:                                                      

                                                                                
def _unescape_basic(s):                                                         
    """Unescape a basic string, ensuring only allowed escapes are present."""   
    # Detect illegal escape sequences                                           
    illegal = re.search(r'\\(?![btnfr"\\uU])', s)                               
    if illegal:                                                                 
        raise ValueError('invalid escape sequence')                             
    # First handle Unicode escapes                                              
    try:                                                                        
        s = s.encode('utf-8').decode('unicode_escape')                          
    except UnicodeDecodeError as e:                                             
        raise ValueError(str(e))                                                
    # Replace TOML specific escapes that overlap with unicode_escape handling   
    s = s.replace('\\b', '\b') \                                                
         .replace('\\t', '\t') \                                                
         .replace('\\n', '\n') \                                                
         .replace('\\f', '\f') \                                                
         .replace('\\r', '\r')                                                  
    return s                                                                    
                                                                                

Now _parse_string: design:                                                      

                                                                                
def _parse_string(token, lines_iter):                                           
    """Parse a TOML string (basic, literal, or multiline)."""                   
    # Basic or literal single line                                              
    if token.startswith('"') and token.endswith('"'):                           
        return _unescape_basic(token[1:-1])                                     
    if token.startswith("'") and token.endswith("'"):                           
        return token[1:-1]                                                      
                                                                                
    # Multiline basic string                                                    
    if token.startswith('"""'):                                                 
        # consume until closing triple quotes                                   
        content_lines = []                                                      
        # part after opening delimiter on same line                             
        after = token[3:]                                                       
        if after:                                                               
            if after.endswith('"""'):                                           
                after = after[:-3]                                              
                content_lines.append(after)                                     
                # no need to read further                                       
            else:                                                               
                content_lines.append(after)                                     
        # read more lines if not closed yet                                     
        while not (content_lines and content_lines[-1].endswith('"""')):        
            try:                                                                
                nxt = next(lines_iter)                                          
            except StopIteration:                                               
                raise ValueError('unterminated multiline basic string')         
            content_lines.append(nxt.rstrip('\n'))                              
        # join and remove closing delimiter                                     
        full = '\n'.join(content_lines)                                         
        # Strip the final triple quotes                                         
        if full.endswith('"""'):                                                
            full = full[:-3]                                                    
        # Trim first newline if present                                         
        if full.startswith('\n'):                                               
            full = full[1:]                                                     
        # Handle line‑ending backslash continuations                            
        full = re.sub(r'\\\r?\n[ \t]*', '', full)                               
        return _unescape_basic(full)                                            
                                                                                
    # Multiline literal string                                                  
    if token.startswith("'''"):                                                 
        content_lines = []                                                      
        after = token[3:]                                                       
        if after:                                                               
            if after.endswith("'''"):                                           
                after = after[:-3]                                              
                content_lines.append(after)                                     
            else:                                                               
                content_lines.append(after)                                     
        while not (content_lines and content_lines[-1].endswith("'''")):        
            try:                                                                
                nxt = next(lines_iter)                                          
            except StopIteration:                                               
                raise ValueError('unterminated multiline literal string')       
            content_lines.append(nxt.rstrip('\n'))                              
        full = '\n'.join(content_lines)                                         
        if full.endswith("'''"):                                                
            full = full[:-3]                                                    
        if full.startswith('\n'):                                               
            full = full[1:]                                                     
        return full                                                             
                                                                                
    raise ValueError('invalid string literal')                                  
                                                                                

Now _parse_array: handle multi-line.                                            

                                                                                
def _parse_array(s, lines_iter):                                                
    """Parse a TOML array, handling possible multi‑line representation."""      
    # Ensure we have the full array literal (balanced brackets)                 
    open_brackets = s.count('[')                                                
    close_brackets = s.count(']')                                               
    array_str = s                                                               
    while open_brackets > close_brackets:                                       
        try:                                                                    
            nxt = next(lines_iter)                                              
        except StopIteration:                                                   
            raise ValueError('unterminated array')                              
        # Strip comments from continuation line                                 
        nxt_clean = _strip_comments(nxt).strip()                                
        array_str += ' ' + nxt_clean                                            
        open_brackets += nxt_clean.count('[')                                   
        close_brackets += nxt_clean.count(']')                                  
    # Now array_str should start with '[' and end with ']'                      
    inner = array_str.strip()                                                   
    if inner.startswith('[') and inner.endswith(']'):                           
        inner = inner[1:-1]                                                     
    else:                                                                       
        raise ValueError('invalid array literal')                               
    elements = []                                                               
    tokens = _split_top_level(inner, ',')                                       
    for token in tokens:                                                        
        if token == '':                                                         
            continue                                                            
        elements.append(_parse_value(token, lines_iter))                        
    return elements                                                             
                                                                                


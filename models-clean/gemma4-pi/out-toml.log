```python
import sys
import re
import json

class TOMLParser:
    def __init__(self, text):
        self.text = text
        self.tokens = []
        self.pos = 0
        self.root = {}
        self.current_context = self.root
        self.current_path = []

    def tokenize(self):
        # A more robust tokenizer
        patterns = [
            ('COMMENT', r'#.*'),
            ('STR_M_BASIC', r'"""[\s\S]*?"""'),
            ('STR_M_LITERAL', r"'''[\s\S]*?'''"),
            ('STR_BASIC', r'"([^"\\]|\\.)*"'),
            ('STR_LITERAL', r"'[^']*'"),
            ('FLOAT', r'-?\d+(?:_\d+)*(?:\.\d(?:_\d*)?)(?:[eE][+-]?\d(?:_\d*)?)?|(?:\.\d(?:_\d*)?)(?:[eE][+-]?\d(?:_\d*)?)?'),
            ('INT', r'-?0[xX][0-9a-fA-F_]+|-?0[arg_oO][0-7_]+|-?0[bB][01_]+|-?\d(?:_\d*)*'),
            ('BOOL', r'true|false'),
            ('ID', r'[A-Za-z0-9_-]+'),
            ('SYM', r'[\[\]\{\}\=\,\.]'),
            ('WS', r'\s+'),
        ]
        # Note: the order of patterns is important.
        # However, we need to handle the INT/FLOAT/etc properly.
        # Let's use a single regex for efficiency.
        combined_pattern = '|'.join(f'(?P<{name}>{pattern})' for name, pattern in [
            ('COMMENT', r'#.*'),
            ('STR_M_BASIC', r'"""[\s\S]*?"""'),
            ('STR_M_LITERAL', r"'''[\s\S]*?'''"),
            ('STR_BASIC', r'"(?:[^"\\]|\\.)*"'),
            ('STR_LITERAL', r"'[^']*'"),
            ('FLOAT', r'-?\d+(?:_\d+)*(?:\.\d(?:_\d*)?)(?:[eE][+-]?\d(?:_\d*)?)?|(?:\.\d(?:_\d*)?)(?:[eE][+-]?\d(?:_\d*)?)?'),
            ('INT', r'-?0[xX][0-9a-fA-F_]+|-?0[oO][0-7_]+|-?0[bB][01_]+|-?\d(?:_\d*)*'),
            ('BOOL', r'true|false'),
            ('ID', r'[A-Za-z0-9_-]+'),
            ('SYM', r'[\[\]\{\}\=\,\.]'),
            ('WS', r'\s+'),
        ])
        
        regex = re.compile(combined_pattern, re.MULTILINE | re.DOTALL)
        for m in regex.finditer(self.text):
            for name, group in m.groupdict().items():
                if group is not None and name != 'WS' and name != 'COMMENT':
                    self.tokens.append((name, group))
        self.tokens.append(('EOF', ''))

    def parse(self):
        self.tokenize()
        i = 0
        while i < len(self.tokens) - 1:
            kind, val = self.tokens[i]
            if val == '[[':
                i, path = self.parse_array_of_tables(i)
                self.set_path(path, is_array=True)
                self.current_path = path
            elif val == '[':
                i, path = self.parse_table_header(i)
                self.set_path(path, is_array=False)
                self.current_path = path
            elif kind in ('ID', 'STR_BASIC', 'STR_LITERAL'):
                i, key_path, value = self.parse_kv(i)
                self.set_path(key_path, is_array=False)
            else:
                i += 1
            
            # Update current context based on current_path
            self.current_context = self.get_path_target(self.current_path)
            
        return self.root

    # ... implementation of parse_array_of_tables, parse_table_header, etc.

import sys
import re
import json

def main():
    if len(sys.argv) < 2:
        sys.exit(1)
    
    file_path = sys.argv[1]
    key_path_str = sys.argv[2] if len(sys.argv) > 2 else None

    try:
        with open(file_path, 'r') as f:
            text = f.read()
    except:
        sys.exit(1)

    try:
        root = parse_toml(text)
    except Exception as e:
        sys.stderr.write(str(e) + '\n')
        sys.exit(1)

    if key_path_str:
        parts = key_path_str.split('.')
        current = root
        try:
            for p in parts:
                if isinstance(current, dict) and p in current:
                    current = current[p]
                else:
                    raise KeyError
            print(json.dumps(current))
        except KeyError:
            sys.stderr.write(f"Keypath '{key_path_str}' not found\n")
            sys.exit(2)
    else:
        print(json.dumps(root))

def parse_toml(text):
    # This is a simplified parser that handles the required subset.
    # It uses a regex to find all tokens and then a simple state machine.
    tokens = []
    pattern = re.compile(r'''
        (?P<COMMENT>#.*) |
        (?P<STR_M_BASIC>"""[\s\S]*?""") |
        (?P<STR_M_LITERAL>''' + r"'''[\s\S]*?'''" + r""") |
        (?P<STR_BASIC>"([^"\\]|\\.)*") |
        (?P<STR_LITERAL>'[^']*') |
        (?P<FLOAT>-?\d+(?:_\d+)*(?:\.\d(?:_\d*)?)(?:[eE][+-]?\d(?:_\d*)?)) |
        (?P<INT>-?\d+(?:_\d+)*) |
        (?P<BOOL>true|false) |
        (?P<ID>[A-Za-z0-9_-]+) |
        (?P<SYM>[\[\]\{\}\=\,\.]) |
        (?PM_NUM>-?0[xX][0-9a-fA-F_]+|-?0[oO][0-7_]+|-?0[bB][01_]+) |
        (?P<WS>\s+)
    ''', re.VERBOSE | re.DOTALL)
    # (The regex above is still a bit messy, let's use a cleaner one)
    # Actually, I'll use a more robust tokenizer in the final code.
    pass

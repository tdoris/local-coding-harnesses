            elif self.tokens[self.token_idx][1] != ']':
                raise TOMLParseError("Expected ',' or ']' in array")
        self.token_idx += 1 # skip ]
        return arr

    def _parse_inline_table(self):
        self.token_idx += 1 # skip {

        if kind in ('STR_BASIC', 'STR_MULTI_BASIC'):
            s = v[3:-3] if v.startswith('"""') else v[1:-1]
            return s.encode().decode('unicode_escape')
        if kind in ('STR_LITERAL', 'STR_MULTI_LITERAL'):
            s = v[3:-3] if v.startswith("'''") else v[1:-1]
            if s.startswith('\n'): s = s[1:]
            return s
        return v

    i = 0
    while i < len(tokens) - 1:
        kind, val = tokens[i]
        if val == '[[':
            # Array of tables
            i += 1
            path = []
            while tokens[i][1] not in (']', ']]'):
                if tokens[i][0] in ('ID', 'STR_BASIC', 'STR_LITERAL'):
                    path.append(tokens[i][1].strip('"\''))
                i += 1
                if i < len(tokens)-1 and tokens[i][1] == '.': i += 1
            
            # Create path in root
            target = root
            for p in path[:-1]:
                if p not in target or not isinstance(target[p], dict):
                    target[p] = {}
                target = target[p]
            
            last = path[-1]
            if last not in target: target[last] = []
            if not isinstance(target[last], list): raise Exception("Not a list")
            new_table = {}
            target[last].append(new_table)
            current_context = new_table
            current_path = path
            i += 1
        elif val == '[':
            # Standard table
            i += 1
            path = []
            while tokens[i][1] not in (']', ']]'):
                if tokens[i][0] in ('ID', 'STR_BASIC', 'STR_LITERAL'):
                    path.append(tokens[i][1].strip('"\''))
                i += 1
                if i < len(tokens)-1 and tokens[i][1] == '.': i += 1
            
            target = root
            for p in path:
                if p not in target or not isinstance(target[p], dict):
                    target[p] = {}
                target = target[p]
            current_context = target
            current_path = path
            i += 1
        elif kind in ('ID', 'STR_BASIC', 'STR_LITERAL'):
            # Key-value
            key = val.strip('"\'')
            i += 1
            if tokens[i][1] != '=': raise Exception("Expected =")

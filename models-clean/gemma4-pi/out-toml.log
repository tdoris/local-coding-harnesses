import sys
import re
import json

def tokenize(text):
    tokens = []
    i = 0
    while i < len(text):
        if text[i].isspace():
            start = i
            while i < len(text) and text[i].isspace():
                i += 1
            tokens.append(('WS', text[start:i]))
            continue
        
        if text[i] == '#':
            start = i
            while i < len(text) and text[i] != '\n':
                i += 1
            tokens.append(('COMMENT', text[start:i]))
            continue

        # Strings
        if text[i] == '"':
            start = i
            i += 1
            while i < len(text):
                if text[i] == '"' and text[i-1] != '\\':
                    i += 1
                    break
                if text[i] == '\\':
                    i += 2
                else:
                    i += 1
            else:
                raise Exception("Unterminated basic string")
            tokens.append(('STR_BASIC', text[start:i]))
            continue
        
        if text[i] == "'":
            start = i
            i += 1
            while i < len(text) and text[i] != "'":
                i += 1
            if i >= len(text):
                raise Exception("Unterminated literal string")
            i += 1
            tokens.append(('STR_LITERAL', text[start:i]))
            continue

        # Triple quotes (simplified)
        if text.startswith('"""', i):
            start = i
            i += 3
            while i < len(text) and not text.startswith('"""', i):
                i += 1
            if i >= len(text):
                raise Exception("Unterminated multi-line basic string")
            i += 3
            tokens.append(('STR_MULTI_BASIC', text[start:i]))
            continue
        if text.startswith("'''", i):
            start = i
            i += 3
            while i < len(text) and not text.startswith("'''", i):
                i += 1
            if i >= len(text):
                raise Exception("Unterminated multi-line literal string")
            i += 3
            tokens.append(('STR_MULTI_LITERAL', text[start:i]))
            continue

        # Numbers, Booleans, Identifiers, Symbols
        match = re.match(r'[a-zA-Z0-9_\-\+\.\*]+', text[i:])
        if match:
            val = match.group()
            if val.lower() == 'true' or val.lower() == 'false':
                tokens.append(('BOOL', val.lower()))
            elif re.match(r'^-?\d+(_\d+)*$', val): # Integer
                tokens.append(('INT', val))
            elif re.match(r'^-?\d+\.\d+([eE][+-]?\d+)?$', val): # Float
                tokens.append(('FLOAT', val))
            else:
                tokens.append(('ID', val))
            i += len(val)
            continue
        
        if text[i] in '[]=.,':
            tokens.append(('SYM', text[i]))
            i += 1
            continue
            
        if text[i] in '[(': # for [[
            if text.startswith('[[', i):
                tokens.append(('ARR_TABLE_START', '[['))
                i += 2
            else:
                tokens.append(('TABLE_START', '['))
                i += 1
            continue
        
        if text[i] == ']':
            if i + 1 < len(text) and text[i:i+2] == ']]':
                tokens.append(('ARR_TABLE_END', ']]'))
                i += 2
            else:
                tokens.append(('SYM', ']'))
                i += 1
            continue

        # Fallback
        i += 1
    return tokens

